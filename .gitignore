# PhysioGuard repository ignore rules

# -----------------------
# Local dumps and external sheets
# -----------------------
*.xlsx
*dump*.txt
Aescode_Round1_Results*
_tmp_*.py
*.tmp
*.temp

# Optional local data exports (keep required CSV inputs committed)
dataset/*.parquet
dataset/*.feather
dataset/raw/
dataset/external/

# -----------------------
# Generated training output
# -----------------------
outputs/
catboost_info/
artifacts/run_*/
artifacts/*.log
artifacts/supervisor_python_*.tmp.log

# -----------------------
# Local archive area
# -----------------------
archive/

# -----------------------
# Local error dumps
# -----------------------
error.log
error.txt
pipeline_error.txt

# -----------------------
# Python environment/cache
# -----------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.ipynb_checkpoints/

# -----------------------
# OS/editor noise
# -----------------------
.DS_Store
Thumbs.db
